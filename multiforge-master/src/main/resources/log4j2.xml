<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console logging for the standalone MultiForge master.

  The master runs outside Minecraft, so it cannot rely on the game's log4j
  configuration. Operators can override this file with -Dlog4j.configurationFile.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss} %level] [%t] %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="io.netty" level="WARN"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
